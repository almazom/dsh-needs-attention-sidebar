{
  "name": "@almazom/dsh-needs-attention-sidebar",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Sidebar 'Needs attention' block for DeepSeek Harness: live Working / Attention / Finished session triage with fatal (red) vs rate-limit (amber) detection. Server-side on-request log scan, zero core edits.",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src/",
    "cordis.patch.yml",
    "screenshots/",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "sessions",
    "monitoring",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almazom/dsh-needs-attention-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/almazom/dsh-needs-attention-sidebar/issues"
  },
  "homepage": "https://github.com/almazom/dsh-needs-attention-sidebar#readme",
  "license": "MIT"
}
